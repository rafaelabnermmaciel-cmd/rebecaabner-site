---
// Botão flutuante de WhatsApp (o mesmo do site Ela me Fez): bolinha verde.
import { waLink } from '../lib/site';
---
<a class="fab-wa" href={waLink()} target="_blank" rel="noopener" aria-label="Conversar com a Rebeca no WhatsApp" title="Conversar no WhatsApp" transition:persist>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.9 13.9c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.5-4-.1-.2-1-1.4-1-2.7s.7-1.9.9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
</a>

<style>
  .fab-wa {
    position: fixed; right: 18px; bottom: 18px; z-index: 45;
    width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center;
    background: #25d366; color: #fff;
    box-shadow: 0 10px 24px -6px rgba(18, 140, 70, .55);
    transition: transform .2s var(--ease), background .2s;
  }
  .fab-wa:hover { background: #1ebe5b; transform: scale(1.06); }
  .fab-wa svg { width: 30px; height: 30px; }
  @media (max-width: 560px) { .fab-wa { width: 52px; height: 52px; right: 14px; bottom: 14px; } .fab-wa svg { width: 27px; height: 27px; } }
</style>
