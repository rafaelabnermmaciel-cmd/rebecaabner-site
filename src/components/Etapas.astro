---
import { ETAPAS } from '../lib/servicos';
import { dois } from '../lib/projetos';
interface Props { compacto?: boolean }
const { compacto = false } = Astro.props;
---
<ol class:list={['etapas', { compacto }]}>
  {ETAPAS.map((e, i) => (
    <li data-reveal>
      <span class="num">{dois(i + 1)}</span>
      <h3>{e.titulo}</h3>
      {!compacto && <p>{e.texto}</p>}
    </li>
  ))}
</ol>

<style>
  .etapas { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; counter-reset: e; }
  li { border-top: 1px solid var(--linha); padding: 18px 0 22px; display: grid; grid-template-columns: 3em 1fr; gap: 4px 12px; }
  li > * { min-width: 0; }
  h3 { font-size: 1.15rem; letter-spacing: -0.03em; line-height: 1.15; }
  p { grid-column: 2; margin: 0; color: var(--tinta-2); font-size: .95rem; max-width: 46ch; }
  .num { padding-top: .35em; }
  @media (min-width: 860px) {
    .etapas { grid-template-columns: repeat(3, 1fr); column-gap: 32px; }
    .compacto { grid-template-columns: 1fr; }
    .compacto li { padding: 12px 0; }
    .compacto h3 { font-size: 1.1rem; }
  }
</style>
