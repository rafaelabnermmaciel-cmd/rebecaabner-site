---
// Monograma "RA" de Rebeca Abner, em vetor, redesenhado a partir do portfólio (traço medido no original).
interface Props { size?: number; class?: string; title?: string }
const { size = 32, class: cls = '', title = 'Rebeca Abner' } = Astro.props;
---
<svg class={cls} width={size} height={Math.round(size * 1.27)} viewBox="0 0 100 127" role="img" aria-label={title} fill="none" stroke="currentColor" shape-rendering="geometricPrecision">
  <path stroke-width="16.4" d="M8.65 127V49.5a41.2 41.2 0 0 1 82.4 0V127" />
  <path stroke-width="16.1" d="M23.4 86H38q8.3 0 12.4 6L77.2 131" />
</svg>
<style>svg { overflow: hidden; display: block; }</style>
