---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjetoCard from '../components/ProjetoCard.astro';
import { projetosPublicados } from '../lib/projetos';
import { waLink } from '../lib/site';
import { u } from '../lib/url';
import Etapas from '../components/Etapas.astro';
import { SERVICOS } from '../lib/servicos';
import { dois } from '../lib/projetos';
import destaque from '../assets/projetos/education-suporte/01-recepcao.webp';
import textura from '../assets/textura-brasilia.webp';

const projetos = (await projetosPublicados()).filter((p) => p.data.destaque);
---
<Base>
  <section class="abertura wrap">
    <p class="rotulo abre-rotulo">Cada espaço começa por quem vai vivê-lo</p>
    <h1 class="display">Rebeca<br />Abner</h1>
    <p class="abre-lado serif">Projetos sob medida,<br />desenhados a partir<br />da sua história.</p>
  </section>

  <figure class="hero">
    <div class="foto hero-foto" data-reveal>
      <Image quality={88} src={destaque} widths={[800, 1200, 1600, 2000, 2400]} sizes="100vw"
        alt="Recepção da Education Suporte: balcão em madeira com o painel orgânico e luz pendente linear" loading="eager" fetchpriority="high" />
    </div>
    <figcaption class="wrap rotulo"><span class="num">01</span> Education Suporte · Brasília, 2024</figcaption>
  </figure>

  <section class="manifesto wrap">
    <p class="serif frase" data-reveal>Ambientes que unem função, beleza e bem-estar.</p>
    <div class="texto" data-reveal>
      <p>Projetos de interiores residenciais e comerciais em Brasília, do primeiro esboço ao acompanhamento da obra.</p>
      <a class="link rotulo" href={u('/sobre')}>Sobre a Rebeca →</a>
    </div>
  </section>

  <section class="selecao wrap" aria-labelledby="t-projetos">
    <header class="sec-topo">
      <h2 id="t-projetos" class="h-2">Projetos</h2>
      <a class="link rotulo" href={u('/projetos')}>Ver todos</a>
    </header>
    <div class="grade">
      {projetos.map((p, i) => (
        <div class={`g g-${i % 3}`}><ProjetoCard projeto={p} tamanho={i % 3 === 1 ? 'pequeno' : 'grande'} /></div>
      ))}
    </div>
  </section>

  <section class="servicos wrap" aria-labelledby="t-serv">
    <header class="sec-topo">
      <h2 id="t-serv" class="h-2">Serviços</h2>
      <a class="link rotulo" href={u('/servicos')}>Como funciona</a>
    </header>
    <ul class="serv-lista">
      {SERVICOS.map((s, i) => (
        <li data-reveal><span class="num">{dois(i + 1)}</span><h3>{s.titulo}</h3><p>{s.texto}</p></li>
      ))}
    </ul>
    <div class="etapas-home">
      <p class="rotulo">Do primeiro contato à obra</p>
      <Etapas compacto />
    </div>
  </section>

  <section class="chamada">
    <Image quality={88} src={textura} alt="" class="chamada-textura" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
    <div class="wrap chamada-in" data-reveal>
      <p class="rotulo">Contato</p>
      <h2 class="h-1">Vamos conversar<br /><span class="serif">sobre o seu espaço?</span></h2>
      <p class="chamada-txt">Conte o que você precisa. Depois da primeira conversa, você recebe uma proposta com escopo, prazo e valor.</p>
      <a class="btn btn--claro btn--cheio-claro" href={waLink()} target="_blank" rel="noopener">Conversar no WhatsApp</a>
    </div>
  </section>
</Base>

<style>
  .abertura { padding-top: clamp(40px, 10vw, 120px); padding-bottom: clamp(28px, 5vw, 56px); display: grid; gap: 28px; }
  .abre-rotulo { margin: 0; color: var(--tinta); }
  .abre-lado { margin: 0; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.15; color: var(--tinta-2); }
  @media (min-width: 860px) {
    .abertura { grid-template-columns: 1fr auto; align-items: end; }
    .abre-rotulo { grid-column: 1 / -1; }
    .abre-lado { text-align: right; padding-bottom: .6em; }
  }
  .hero { margin: 0; }
  .hero-foto { aspect-ratio: 4 / 5; max-height: 92svh; width: 100%; }
  .hero figcaption { padding-top: 14px; display: flex; gap: 14px; }
  @media (min-width: 700px) { .hero-foto { aspect-ratio: 16 / 9; } }

  .manifesto { display: grid; gap: 28px; padding-block: clamp(72px, 14vw, 180px); }
  .manifesto .texto { align-self: end; }
  @media (min-width: 860px) { .manifesto { grid-template-columns: 1.4fr 1fr; gap: 64px; } }

  .sec-topo { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--tinta); padding-top: 18px; margin-bottom: clamp(36px, 6vw, 72px); }
  .grade { display: grid; gap: clamp(56px, 9vw, 120px); }
  @media (min-width: 860px) {
    .grade { grid-template-columns: repeat(12, 1fr); column-gap: 24px; }
    .g-0 { grid-column: 1 / span 8; }
    .g-1 { grid-column: 9 / span 4; margin-top: 38%; }
    .g-2 { grid-column: 3 / span 8; }
  }

  .acoes { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .servicos { margin-top: clamp(96px, 14vw, 180px); }
  .serv-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  .serv-lista li { display: grid; grid-template-columns: 3em 1fr; gap: 6px 12px; }
  .serv-lista h3 { font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.04em; }
  .serv-lista p { grid-column: 2; margin: 0; color: var(--tinta-2); max-width: 44ch; }
  .serv-lista .num { padding-top: .5em; }
  .etapas-home { margin-top: clamp(56px, 8vw, 96px); display: grid; gap: 16px; }
  .etapas-home > .rotulo { margin: 0; color: var(--tinta); }
  @media (min-width: 860px) {
    .serv-lista { grid-template-columns: repeat(4, 1fr); gap: 32px; }
    .serv-lista li { grid-template-columns: 1fr; }
    .serv-lista p { grid-column: 1; }
    .etapas-home :global(.etapas.compacto) { grid-template-columns: repeat(6, 1fr); column-gap: 20px; }
    .etapas-home :global(.etapas.compacto li) { grid-template-columns: 1fr; }
  }
  .chamada-txt { max-width: 46ch; color: color-mix(in srgb, var(--papel) 80%, transparent); margin: 0; }
  .btn--cheio-claro { background: var(--papel); color: var(--tinta); border-color: var(--papel); }
  .btn--cheio-claro:hover { background: var(--terracota); color: var(--papel); border-color: var(--terracota); }
  .chamada { position: relative; margin-top: clamp(96px, 14vw, 180px); background: var(--tinta); color: var(--papel); overflow: hidden; }
  .chamada-textura { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .22; filter: grayscale(1) contrast(1.1); }
  .chamada-in { position: relative; padding-block: clamp(80px, 14vw, 180px); display: grid; gap: 28px; justify-items: start; }
  .chamada .rotulo { color: color-mix(in srgb, var(--papel) 70%, transparent); margin: 0; }
  .chamada h2 { color: var(--papel); }
  .chamada .btn:hover { background: var(--papel); color: var(--tinta); border-color: var(--papel); }
</style>
