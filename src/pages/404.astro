---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base titulo="Página não encontrada">
  <section class="wrap" style="padding-block: 18vh; display: grid; gap: 28px; justify-items: start;">
    <p class="rotulo">Erro 404</p>
    <h1 class="h-1">Este ambiente<br /><span class="serif">ainda não existe.</span></h1>
    <a class="btn" href={u('/')}>Voltar ao início</a>
  </section>
</Base>
