---
import Base from '../layouts/Base.astro';
import Etapas from '../components/Etapas.astro';
import { SERVICOS, PERGUNTAS } from '../lib/servicos';
import { dois } from '../lib/projetos';
import { u } from '../lib/url';
const faq = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: PERGUNTAS.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
---
<Base titulo="Serviços" descricao="Projeto de interiores residencial e comercial, marcenaria sob medida e consultoria em Brasília. Veja como funciona um projeto, do primeiro contato à obra.">
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  <section class="wrap cab">
    <p class="rotulo">Serviços</p>
    <h1 class="h-1">Do primeiro esboço<br /><span class="serif">à obra pronta.</span></h1>
    <p class="texto">Projetos de interiores para casas e empresas em Brasília. Cada proposta é feita sob medida, a partir de uma conversa sobre o seu espaço.</p>
  </section>

  <section class="wrap bloco" aria-labelledby="t-servicos">
    <h2 id="t-servicos" class="rotulo">Projetos</h2>
    <ul class="servicos">
      {SERVICOS.map((s, i) => (
        <li data-reveal><span class="num">{dois(i + 1)}</span><h3 class="h-serv">{s.titulo}</h3><p>{s.texto}</p></li>
      ))}
    </ul>
  </section>

  <section class="wrap bloco" aria-labelledby="t-como">
    <h2 id="t-como" class="rotulo">O caminho</h2>
    <Etapas />
  </section>

  <section class="wrap bloco" aria-labelledby="t-faq">
    <h2 id="t-faq" class="rotulo">Dúvidas</h2>
    <div class="faq">
      {PERGUNTAS.map((q, i) => (
        <details open={i === 0}><summary>{q.p}</summary><p>{q.r}</p></details>
      ))}
    </div>
  </section>

  <section class="faixa">
    <div class="wrap faixa-in" data-reveal>
      <h2 class="h-2">Vamos falar do seu espaço?</h2>
      <a class="btn btn--claro" href={u('/contato')}>Começar uma conversa</a>
    </div>
  </section>
</Base>

<style>
  .cab { padding-top: clamp(40px, 9vw, 110px); padding-bottom: clamp(48px, 8vw, 100px); display: grid; gap: 24px; }
  .cab .rotulo { margin: 0; }
  .acoes { display: flex; flex-wrap: wrap; gap: 20px 28px; align-items: center; }
  .bloco { border-top: 1px solid var(--tinta); padding-top: 22px; padding-bottom: clamp(56px, 8vw, 96px); display: grid; gap: 24px; }
  .bloco > * { min-width: 0; }
  .bloco > h2 { margin: 0; color: var(--tinta); }
  @media (min-width: 860px) { .bloco { grid-template-columns: 3fr 9fr; gap: 6vw; } }
  .servicos { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  .servicos li { display: grid; grid-template-columns: 3em 1fr; gap: 6px 12px; }
  .servicos p { grid-column: 2; margin: 0; color: var(--tinta-2); max-width: 48ch; }
  .h-serv { font-size: clamp(1.3rem, 2.2vw, 1.75rem); letter-spacing: -0.035em; line-height: 1.1; }
  .servicos .num { padding-top: .6em; }
  @media (min-width: 860px) { .servicos { grid-template-columns: 1fr 1fr; gap: 48px 40px; } }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; align-content: start; }
  .tags li { border: 1px solid var(--linha); border-radius: 999px; padding: .5em 1.1em; font-size: .92rem; }
  .faq details { border-top: 1px solid var(--linha); padding: 16px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--linha); }
  .faq summary { cursor: pointer; font: 500 1.05rem/1.3 var(--f-titulo); letter-spacing: -0.02em; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-weight: 400; transition: transform .3s var(--ease); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { margin: 10px 0 0; color: var(--tinta-2); max-width: 62ch; }
  .faixa { background: var(--terracota); color: var(--papel); }
  .faixa-in { padding-block: clamp(56px, 9vw, 110px); display: grid; gap: 28px; justify-items: start; }
  .faixa h2 { color: var(--papel); }
  @media (min-width: 860px) { .faixa-in { grid-template-columns: 1fr auto; align-items: end; } }
</style>
