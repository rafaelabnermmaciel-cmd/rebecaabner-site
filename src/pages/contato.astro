---
import Base from '../layouts/Base.astro';
import { SITE, waLink } from '../lib/site';
const canais = [
  { rotulo: 'WhatsApp', valor: SITE.whatsappExibicao, href: waLink(), ext: true },
  { rotulo: 'E-mail', valor: SITE.email, href: `mailto:${SITE.email}` },
  { rotulo: 'Instagram', valor: `@${SITE.instagram}`, href: `https://www.instagram.com/${SITE.instagram}`, ext: true },
  { rotulo: 'LinkedIn', valor: SITE.linkedin, href: `https://www.linkedin.com/in/${SITE.linkedin}`, ext: true },
];
---
<Base titulo="Contato" descricao="Fale com Rebeca Abner, designer de interiores em Brasília, pelo WhatsApp, e-mail ou Instagram.">
  <section class="wrap cab">
    <p class="rotulo">Contato</p>
    <h1 class="h-1">Vamos<br /><span class="serif">conversar?</span></h1>
    <p class="texto">Conte um pouco sobre o seu espaço: o que é, onde fica e o que você gostaria de mudar. A resposta vem pelo canal que você preferir.</p>
  </section>
  <ul class="wrap canais">
    {canais.map((c) => (
      <li data-reveal>
        <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
          <span class="rotulo">{c.rotulo}</span>
          <span class="valor">{c.valor}</span>
          <span class="seta" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .cab { padding-top: clamp(40px, 9vw, 110px); padding-bottom: clamp(48px, 8vw, 100px); display: grid; gap: 24px; }
  .cab .rotulo { margin: 0; }
  .canais { list-style: none; margin: 0 auto; padding-bottom: clamp(80px, 12vw, 160px); }
  .canais li { border-top: 1px solid var(--tinta); }
  .canais li:last-child { border-bottom: 1px solid var(--tinta); }
  .canais a { display: grid; grid-template-columns: 1fr auto; gap: 6px 16px; padding: 26px 0; align-items: baseline; }
  .canais .rotulo { grid-column: 1 / -1; }
  .valor { font: 500 clamp(1.4rem, 4.6vw, 3rem)/1.05 var(--f-titulo); letter-spacing: -0.035em; word-break: break-word; }
  .seta { font-size: 1.6rem; transition: transform .4s var(--ease); }
  .canais a:hover .seta { transform: translateX(8px); }
  .canais a:hover .valor { color: var(--terracota); }
  @media (min-width: 860px) { .canais a { grid-template-columns: 14em 1fr auto; } .canais .rotulo { grid-column: auto; } }
</style>
